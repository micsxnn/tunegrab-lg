<?xml version="1.0" encoding="utf-8"?>
<!-- Cápsula de vidro estático (v0.23.1-lg): a pastilha "Letra" e chips que
     flutuam sobre o ambiente — fill 8% + hairline 16% (o vidro AO VIVO fica
     por conta do LiquidGlassView; cápsulas pequenas seguram o efeito aqui) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14FFFFFF" />
    <corners android:radius="99dp" />
    <stroke
        android:width="1dp"
        android:color="#29FFFFFF" />
</shape>
