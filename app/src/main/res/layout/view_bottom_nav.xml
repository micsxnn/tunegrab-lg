<?xml version="1.0" encoding="utf-8"?>
<!-- PÍLULA DE LIQUID GLASS REAL (tunegrab-lg v0.23.1-lg): a ExpandingNavBar
     "empurra" (v0.19.3) flutua num LiquidGlassView do motor dev.liquidglass
     — refração de borda + aberração cromática + rim especular via AGSL na
     API 33+, blur+saturação na 31+, scrim+rim antes disso. As propriedades
     do material entram no MainActivity; o provider é o contentProvider da
     activity (as telas rolando POR TRÁS da barra). Mesmo ID bottomNav de
     sempre — binding e navegação não mudam. -->
<dev.liquidglass.view.LiquidGlassView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navGlass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp">

    <com.tunegrab.app.ui.ExpandingNavBar
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />
</dev.liquidglass.view.LiquidGlassView>
